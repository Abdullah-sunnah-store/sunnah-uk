{% comment %}
  TSS — Footer
  Deep emerald ground: gold letter-spaced wordmark, accordion link columns,
  payment wordmarks, socials, region toggle and copyright.
{% endcomment %}

{% render 'tss-base' %}

{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}

<style>
  #tss-footer-{{ uid }} {
    background: var(--tss-green-dark);
    color: var(--tss-ivory);
    padding: {{ s.padding_top | default: 64 }}px var(--tss-gutter) {{ s.padding_bottom | default: 40 }}px;
  }

  #tss-footer-{{ uid }} .tss-foot__wordmark {
    display: block;
    text-align: center;
    font-family: var(--tss-serif);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--tss-gold);
    text-decoration: none;
  }

  #tss-footer-{{ uid }} .tss-foot__logo {
    display: block;
    margin: 0 auto;
    max-width: 200px;
    height: auto;
  }

  #tss-footer-{{ uid }} .tss-foot__cols {
    margin-top: 40px;
    border-top: 1px solid rgb(245 240 232 / 0.1);
  }

  #tss-footer-{{ uid }} .tss-foot__col {
    border-bottom: 1px solid rgb(245 240 232 / 0.1);
  }

  #tss-footer-{{ uid }} .tss-foot__toggle {
    display: flex;
    height: 56px;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    border: 0;
    background: transparent;
    padding: 0;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font-family: var(--tss-sans);
  }

  #tss-footer-{{ uid }} .tss-foot__toggle span {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(245 240 232 / 0.8);
  }

  #tss-footer-{{ uid }} .tss-foot__toggle .tss-icon {
    width: 16px;
    height: 16px;
    color: rgb(245 240 232 / 0.5);
    transition: transform 0.4s ease;
  }

  #tss-footer-{{ uid }} .tss-foot__toggle[aria-expanded='true'] .tss-icon {
    transform: rotate(180deg);
  }

  #tss-footer-{{ uid }} .tss-foot__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s var(--tss-ease);
  }

  #tss-footer-{{ uid }} .tss-foot__panel[data-open='true'] {
    grid-template-rows: 1fr;
  }

  #tss-footer-{{ uid }} .tss-foot__panel > ul {
    overflow: hidden;
  }

  #tss-footer-{{ uid }} .tss-foot__panel li {
    padding-bottom: 16px;
  }

  #tss-footer-{{ uid }} .tss-foot__panel li:first-child {
    padding-top: 4px;
  }

  #tss-footer-{{ uid }} .tss-foot__panel a {
    font-size: 14px;
    font-weight: 300;
    color: rgb(245 240 232 / 0.65);
    text-decoration: none;
    transition: color 0.4s ease;
  }

  #tss-footer-{{ uid }} .tss-foot__panel a:hover {
    color: var(--tss-gold-bright);
  }

  #tss-footer-{{ uid }} .tss-foot__base {
    margin-top: 48px;
    border-top: 1px solid rgb(245 240 232 / 0.1);
    padding-top: 32px;
  }

  #tss-footer-{{ uid }} .tss-foot__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 16px;
    row-gap: 8px;
  }

  #tss-footer-{{ uid }} .tss-foot__payments li {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgb(245 240 232 / 0.5);
  }

  #tss-footer-{{ uid }} .tss-foot__social {
    display: flex;
    justify-content: center;
    gap: 32px;
    margin-top: 32px;
  }

  #tss-footer-{{ uid }} .tss-foot__social a {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(245 240 232 / 0.55);
    text-decoration: none;
    transition: color 0.4s ease;
  }

  #tss-footer-{{ uid }} .tss-foot__social a:hover {
    color: var(--tss-gold-bright);
  }

  #tss-footer-{{ uid }} .tss-foot__region {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  #tss-footer-{{ uid }} .tss-foot__copy {
    margin-top: 32px;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: rgb(245 240 232 / 0.4);
  }
</style>

<footer id="tss-footer-{{ uid }}" class="tss-section">
  {%- if s.logo != blank -%}
    <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {{ s.logo | image_url: width: 400 | image_tag: class: 'tss-foot__logo', alt: shop.name }}
    </a>
  {%- else -%}
    <a href="{{ routes.root_url }}" class="tss-foot__wordmark">
      {{- s.wordmark | default: shop.name | escape -}}
    </a>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="tss-foot__cols">
      {%- for block in section.blocks -%}
        {%- liquid
          assign menu = linklists[block.settings.menu]
          # Fall back to the store's default menu when the chosen link list is missing or empty
          assign menu_size = menu.links.size | default: 0
          if menu_size == 0
            assign menu = linklists['main-menu']
          endif
        -%}
        <div class="tss-foot__col" {{ block.shopify_attributes }}>
          <button
            type="button"
            class="tss-foot__toggle"
            aria-expanded="false"
            aria-controls="tss-foot-panel-{{ block.id }}"
            data-tss-accordion
          >
            <span>{{ block.settings.title | default: menu.title | escape }}</span>
            {% render 'tss-icon', icon: 'chevron-down', size: 16, stroke: 1.5 %}
          </button>

          <div class="tss-foot__panel" id="tss-foot-panel-{{ block.id }}" data-open="false">
            <ul>
              {%- for link in menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="tss-foot__base">
    {%- if s.payments != blank -%}
      <ul class="tss-foot__payments">
        {%- assign payment_items = s.payments | split: ',' -%}
        {%- for item in payment_items -%}
          <li>{{ item | strip | escape }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if s.social_menu != blank -%}
      {%- assign social = linklists[s.social_menu] -%}
      {%- if social.links.size > 0 -%}
        <div class="tss-foot__social">
          {%- for link in social.links -%}
            <a
              href="{{ link.url }}"
              aria-label="{{ shop.name }} on {{ link.title | escape }}"
              rel="noopener"
              target="_blank"
            >
              {{- link.title | escape -}}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if s.show_region and localization.available_countries.size > 1 -%}
      <div class="tss-foot__region">{% render 'tss-region-toggle', long: true %}</div>
    {%- endif -%}

    <p class="tss-foot__copy">
      &copy; {{ 'now' | date: '%Y' }} {{ s.copyright | default: shop.name | escape }}
    </p>
  </div>
</footer>

<script>
  (function () {
    var root = document.getElementById('tss-footer-{{ uid }}');
    if (!root || root.__tssBound) return;
    root.__tssBound = true;

    root.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-tss-accordion]');
      if (!btn) return;
      var panel = document.getElementById(btn.getAttribute('aria-controls'));
      if (!panel) return;
      var open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      panel.setAttribute('data-open', String(!open));
    });
  })();
</script>

{% schema %}
{
  "name": "TSS · Footer",
  "settings": [
    { "type": "header", "content": "Identity" },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Falls back to the wordmark below." },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "THE SUNNAH STORE" },
    { "type": "header", "content": "Base row" },
    {
      "type": "text",
      "id": "payments",
      "label": "Payment methods",
      "info": "Comma separated.",
      "default": "Cash on Delivery, bKash, Visa, Mastercard"
    },
    { "type": "link_list", "id": "social_menu", "label": "Social menu" },
    { "type": "checkbox", "id": "show_region", "label": "Show region / currency toggle", "default": true },
    { "type": "text", "id": "copyright", "label": "Copyright name" },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shopping" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "TSS · Footer",
      "blocks": [
        { "type": "column", "settings": { "title": "Shopping" } },
        { "type": "column", "settings": { "title": "Gifting" } },
        { "type": "column", "settings": { "title": "Our House" } },
        { "type": "column", "settings": { "title": "Help" } }
      ]
    }
  ]
}
{% endschema %}
