    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote",
      "default": "#F5F0E8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (bar, avatar, price)",
      "default": "#D4A830"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Primary button background",
      "default": "#D4A830"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Primary button text",
