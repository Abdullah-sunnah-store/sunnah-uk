      "label": "Secondary button text / border base",
      "default": "#F5F0E8"
    },
    {
      "type": "color",
      "id": "btn2_border",
      "label": "Secondary button border",
      "default": "#F5F0E8"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading & quote font",
      "default": "cormorant_n7"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 300,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 560
    }
  ],
  "presets": [
    {
      "name": "Founder's Edit"
    }
  ]
}
{% endschema %}
