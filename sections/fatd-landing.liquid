{{ 'fatd-landing.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap"
>

{%- liquid
  assign buy_url = section.settings.buy_link
  if section.settings.product != blank
    assign buy_url = section.settings.product.url
  endif
  if buy_url == blank
    assign buy_url = '#'
  endif

  assign price = section.settings.price
  assign cta = section.settings.cta_label
-%}

{%- capture buy_button -%}
  <a class="fatd__btn" href="{{ buy_url }}">{{ cta }} <span class="fatd__btn-price">— {{ price }}</span></a>
{%- endcapture -%}

<div class="fatd{% if section.settings.content_width == 'theme' %} fatd--wide{% endif %}">
  <section class="fatd__section fatd__hero">
    <div class="fatd__inner fatd__hero-grid">
      <div class="fatd__hero-media">
        {%- if section.settings.cover_image != blank -%}
          {{
            section.settings.cover_image
            | image_url: width: 840
            | image_tag: widths: '340, 420, 680, 840', alt: section.settings.cover_alt, fetchpriority: 'high'
          }}
        {%- else -%}
          <img
            src="{{ 'fatd-book-cover.png' | asset_url }}"
            alt="{{ section.settings.cover_alt | escape }}"
            width="420"
            height="560"
            fetchpriority="high"
          >
        {%- endif -%}
      </div>

      <div>
        <p class="fatd__hero-kicker">{{ section.settings.hero_kicker }}</p>
        <p class="fatd__hero-sub">{{ section.settings.hero_sub }}</p>
        <h1 class="fatd__h1">{{ section.settings.hero_title }}</h1>
        <p class="fatd__hero-tagline">{{ section.settings.hero_tagline }}</p>
        <div class="fatd__hero-cta">
          {{ buy_button }}
          <p class="fatd__btn-note">{{ section.settings.hero_note }}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="fatd__section fatd__section--alt">
    <div class="fatd__inner fatd__narrative">
      <p class="fatd__lead">
        Someone in the house is not right. A child who won't stop crying. A marriage that turned cold for
        no reason anyone can name. Sleep that doesn't come. Tests that come back normal.
      </p>
      <p class="fatd__lead">
        You look for help and find three options: a raqi who is too far away, one who is too expensive, or
        someone whose method you cannot check — reciting words you don't recognise over the people you love.
      </p>
      <p class="fatd__emphasis" style="color: var(--fatd-primary);">
        That last one is how families end up somewhere far worse than where they started.
      </p>
      <div class="fatd__cta-row">{{ buy_button }}</div>
    </div>
  </section>

  <section class="fatd__section">
    <div class="fatd__inner">
      <p class="fatd__eyebrow">What this actually is</p>
      <h2 class="fatd__h2">This is a manual, not<br>a book about ruqyah.</h2>
      <p class="fatd__lead fatd__prose">
        185 pages. 21 chapters. Every du'a with its Arabic, its transliteration, its meaning, when to say it
        and how many times. The four full recitation programmes — ʿAmmah, Tawbah, Qital, Harq — set out
        verse by verse in order.
      </p>
      <p class="fatd__lead fatd__prose">
        It was written in Bengali by a teacher who has trained close to a thousand students in prophetic
        medicine. It has been translated, restructured and checked for English readers.
      </p>

      <div class="fatd__spreads">
        {%- for i in (1..4) -%}
          {%- liquid
            case i
              when 1
                assign spread = section.settings.spread_1
                assign fallback = 'fatd-spread-dua-card.png'
              when 2
                assign spread = section.settings.spread_2
                assign fallback = 'fatd-spread-verse-block.png'
              when 3
                assign spread = section.settings.spread_3
                assign fallback = 'fatd-spread-protection.png'
              else
                assign spread = section.settings.spread_4
                assign fallback = 'fatd-spread-medicine.png'
            endcase
          -%}
          {%- if spread != blank -%}
            {{ spread | image_url: width: 600 | image_tag: widths: '300, 450, 600', alt: 'Spread from inside the book', loading: 'lazy' }}
          {%- else -%}
            <img src="{{ fallback | asset_url }}" alt="Spread from inside the book" loading="lazy" width="600" height="450">
          {%- endif -%}
        {%- endfor -%}
      </div>
      <p class="fatd__caption">Real spreads from inside the book.</p>
    </div>
  </section>

  <section class="fatd__section fatd__section--teal">
    <div class="fatd__inner">
      <p class="fatd__eyebrow">Why you can trust it</p>
      <h2 class="fatd__h2">Every reference in this<br>book has been checked.</h2>
      <p class="fatd__lead fatd__prose">
        Most Islamic books on this subject cite &ldquo;Bukhari&rdquo; or &ldquo;Tirmidhi&rdquo; with no
        number, and no grading. You cannot verify them, so you have to take them on faith.
      </p>
      <p class="fatd__emphasis">This one is different.</p>

      <ul class="fatd__checks">
        {%- assign trust_points = 'Every hadith carries its collection and its number, using sunnah.com’s numbering — so you can look it up in thirty seconds.|Where a narration is weak or disputed, the grading is printed with it.|Where a report is from a Companion or a Successor rather than the Prophet ﷺ, it says so.|Where a reference could not be traced, the book admits it rather than inventing one.' | split: '|' -%}
        {%- for point in trust_points -%}
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="m8 12 3 3 5-6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span>{{ point }}</span>
          </li>
        {%- endfor -%}
      </ul>

      <blockquote class="fatd__quote">
        You are not asked to trust us. You are given what you need to check.
      </blockquote>
    </div>
  </section>

  <section class="fatd__section fatd__section--alt">
    <div class="fatd__inner fatd__center">
      <p class="fatd__eyebrow">What's inside</p>
      <h2 class="fatd__h2">Everything laid out so<br>you can start today.</h2>

      <div class="fatd__cards">
        <div class="fatd__card">
          <div class="fatd__card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3>Daily protection — three levels</h3>
          <p>Level 1 is eight du'as, morning and evening, about two minutes. Start there.</p>
        </div>

        <div class="fatd__card">
          <div class="fatd__card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M20.8 6.6a5 5 0 0 0-8.8-1.9A5 5 0 0 0 3.2 6.6c-1 2.6.6 5 2.3 6.7L12 19l6.5-5.7c1.7-1.7 3.3-4.1 2.3-6.7z" stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3>Hadith-based ruqyah, 1–14</h3>
          <p>For headaches, pain, fever, the evil eye, fear, sleeplessness — with the method for each.</p>
        </div>

        <div class="fatd__card">
          <div class="fatd__card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01" stroke-linecap="round"></path>
            </svg>
          </div>
          <h3>The four programmes</h3>
          <p>ʿAmmah finds the problem. Tawbah softens the ground. Qital and Harq follow. Set out in full, in order.</p>
        </div>

        <div class="fatd__card">
          <div class="fatd__card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M11 20A7 7 0 0 1 4 13c0-5 4-9 9-9 3 0 7 1 7 1s-1 15-9 15z" stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3>Prophetic medicine</h3>
          <p>Black seed, honey, hijama, olive oil, miswak, nabeez — with the hadith and the practical limits.</p>
        </div>
      </div>

      <div class="fatd__cta-row">{{ buy_button }}</div>
    </div>
  </section>

  <section class="fatd__section">
    <div class="fatd__inner">
      <p class="fatd__eyebrow">Sobriety, not sensation</p>
      <h2 class="fatd__h2">It also tells you when to see a doctor.</h2>
      <p class="fatd__lead fatd__prose">
        Most books on ruqyah don't. This one has a full chapter on it — because the signs of sihr and the
        evil eye overlap heavily with ordinary illness, and a book that ignores that can do real harm.
      </p>
      <p class="fatd__lead fatd__prose">
        It names the symptoms that need a doctor today. It says plainly that depression and psychosis are
        real, treatable illness and not weakness of faith. And it gives eight tests for telling a genuine
        raqi from someone who will lead you into shirk.
      </p>
      <p class="fatd__callout">Seeking treatment is Sunnah. This book says so on page 45.</p>
    </div>
  </section>

  <section class="fatd__section fatd__section--alt">
    <div class="fatd__inner">
      <p class="fatd__eyebrow">Who wrote it</p>
      <h2 class="fatd__h2">Written by people who needed it first.</h2>

      <div class="fatd__authors">
        <div class="fatd__card">
          <div class="fatd__author-head">
            <span class="fatd__avatar" aria-hidden="true">SM</span>
            <span>
              <span class="fatd__author-name">Sheikh Khandaker Marsus</span>
              <span class="fatd__author-role" style="display: block;">Author</span>
            </span>
          </div>
          <p class="fatd__author-bio">
            Came to ruqyah because someone in his own family needed help and there was none nearby. He
            trained formally, first online and then in person, and has since taught prophetic medicine to
            close to a thousand students.
          </p>
        </div>

        <div class="fatd__card">
          <div class="fatd__author-head">
            <span class="fatd__avatar" aria-hidden="true">RS</span>
            <span>
              <span class="fatd__author-name">Rashid Shahriar</span>
              <span class="fatd__author-role" style="display: block;">Translator</span>
            </span>
          </div>
          <p class="fatd__author-bio">
            Translated it into English because nothing like it existed for the families who needed it — and
            because a book that stays in one language only helps the people who already had help nearby.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="fatd__section">
    <div class="fatd__inner fatd__center">
      <p class="fatd__eyebrow">The demand is real</p>
      <div class="fatd__stat">
        <span class="fatd__stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 3h12v18l-6-4-6 4z" stroke-linejoin="round"></path>
          </svg>
        </span>
        <p class="fatd__stat-number">{{ section.settings.stat_number }}</p>
        <p class="fatd__stat-label">{{ section.settings.stat_label }}</p>
        <p class="fatd__stat-note">Families asking for exactly this, in their own words.</p>
      </div>
    </div>
  </section>

  <section class="fatd__section fatd__section--teal">
    <div class="fatd__inner">
      <div class="fatd__offer">
        <h2>{{ section.settings.hero_title }}</h2>
        <p class="fatd__offer-price">{{ price }}</p>

        <ul class="fatd__offer-list">
          {%- assign offer_points = '185-page book, instant PDF download|Read on phone, tablet, laptop — or print it|Every reference checked and graded|Free updates — buy once, get every future edition' | split: '|' -%}
          {%- for point in offer_points -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="m4 12 5 5L20 6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span>{{ point }}</span>
            </li>
          {%- endfor -%}
        </ul>

        <a class="fatd__btn fatd__btn--light" href="{{ buy_url }}">
          {{ cta }} <span class="fatd__btn-price">— {{ price }}</span>
        </a>
        <p class="fatd__btn-note">{{ section.settings.checkout_note }}</p>
      </div>
    </div>
  </section>

  <section class="fatd__section">
    <div class="fatd__inner fatd__prose">
      <h2 class="fatd__h2 fatd__h2--sm">A word about the price.</h2>
      <p class="fatd__lead">
        This book argues that the cost of help should come down, and here you are being asked to pay for it.
        The two aren't in conflict: a book you own forever is not a healer's fee you pay at every visit, and
        what you pay covers the translation, the checking of every reference, and the next edition.
      </p>
      <p class="fatd__emphasis">
        If the price is genuinely beyond you, write to us. We will send it to you.
      </p>
    </div>
  </section>

  <section class="fatd__section fatd__section--alt">
    <div class="fatd__inner">
      <p class="fatd__eyebrow">Questions</p>
      <h2 class="fatd__h2">Before you buy</h2>

      <div class="fatd__faq">
        {%- assign faqs = 'Is this a physical book?~No — a PDF you download immediately. You can read it on any device or print it.|Do I need to read Arabic?~No. Every du’a has the Arabic, a transliteration, and the meaning. The book encourages you to learn the Arabic and shows you how to start.|Is ruqyah allowed?~Yes — reciting the Qur’an and authentic supplication over yourself or others is established in the Sunnah. The book is careful to distinguish this from practices that are not.|Is it for men or women?~Both. It’s written for households.|Can I perform ruqyah on my own family?~Yes. That’s the entire point of the book.|Is it suitable for someone with no background?~Yes. Start with Level 1 in chapter 4 — eight du’as, two minutes a day.|Can I share it?~Please don’t send the file on. If someone needs it and can’t afford it, tell them to write to us.' | split: '|' -%}
        {%- for faq in faqs -%}
          {%- assign parts = faq | split: '~' -%}
          <details>
            <summary>{{ parts[0] }}</summary>
            <p>{{ parts[1] }}</p>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="fatd__section">
    <div class="fatd__inner fatd__final">
      <h2>{{ section.settings.hero_kicker }}</h2>
      <p class="fatd__final-meta">{{ section.settings.hero_title }} · 185 pages · {{ price }}</p>
      <a class="fatd__btn" href="{{ buy_url }}">{{ cta }}</a>
    </div>
  </section>

  <section class="fatd__section fatd__section--deep">
    <div class="fatd__inner fatd__newsletter">
      <span class="fatd__newsletter-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
      <h2>Not ready? Take the daily protection set instead.</h2>
      <p class="fatd__newsletter-sub">
        The eight du'as, morning and evening. Two minutes a day. Free.
      </p>

      {%- form 'customer', class: 'fatd__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, fight-against-the-devil">
        <label class="visually-hidden" for="FatdEmail-{{ section.id }}">Email address</label>
        <input
          id="FatdEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          placeholder="you@example.com"
          autocomplete="email"
          required
        >
        <button type="submit" class="fatd__btn fatd__btn--light">Send it to me</button>

        {%- if form.errors -%}
          <p class="fatd__form-message fatd__form-message--error" style="flex: 1 1 100%;">
            {{ form.errors.messages['email'] }}
          </p>
        {%- elsif form.posted_successfully? -%}
          <p class="fatd__form-message" style="flex: 1 1 100%;">Check your inbox — it's on its way.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </section>

  <footer class="fatd__footer">
    <p>{{ section.settings.hero_title }} · Instant PDF · {{ price }}</p>
    <p>Questions or can't afford it? Write to us — we'll help.</p>
  </footer>

  <div class="fatd__sticky">
    <span class="fatd__sticky-label">
      <strong class="fatd__sticky-title">{{ section.settings.hero_title }}</strong>
      {{ price }} · instant download
    </span>
    <a class="fatd__btn" href="{{ buy_url }}">{{ cta }}</a>
  </div>
</div>

{% schema %}
{
  "name": "FATD landing",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        { "value": "theme", "label": "Match theme page width" },
        { "value": "design", "label": "Narrow (original design, 1024px)" }
      ],
      "default": "theme",
      "info": "\"Match theme page width\" lines the page up with the header and the rest of the store."
    },
    {
      "type": "header",
      "content": "Buy link"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Takes priority over the link below."
    },
    {
      "type": "url",
      "id": "buy_link",
      "label": "Fallback link"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Get the book"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "£8.99"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "hero_kicker",
      "label": "Kicker",
      "default": "There is no raqi coming."
    },
    {
      "type": "textarea",
      "id": "hero_sub",
      "label": "Sub-heading",
      "default": "When something is wrong in your home, the help is usually far away, expensive, or someone you can't verify. This book teaches you to do it yourself."
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Book title",
      "default": "Fight Against The Devil"
    },
    {
      "type": "textarea",
      "id": "hero_tagline",
      "label": "Tagline",
      "default": "A practical guide to ruqyah and prophetic medicine you can use at home tonight."
    },
    {
      "type": "text",
      "id": "hero_note",
      "label": "Note under button",
      "default": "Instant download · 185 pages · Read on any device"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Book cover"
    },
    {
      "type": "text",
      "id": "cover_alt",
      "label": "Cover alt text",
      "default": "Cover of the book Fight Against The Devil"
    },
    {
      "type": "image_picker",
      "id": "spread_1",
      "label": "Spread 1"
    },
    {
      "type": "image_picker",
      "id": "spread_2",
      "label": "Spread 2"
    },
    {
      "type": "image_picker",
      "id": "spread_3",
      "label": "Spread 3"
    },
    {
      "type": "image_picker",
      "id": "spread_4",
      "label": "Spread 4"
    },
    {
      "type": "header",
      "content": "Proof"
    },
    {
      "type": "text",
      "id": "stat_number",
      "label": "Stat",
      "default": "7,900+"
    },
    {
      "type": "text",
      "id": "stat_label",
      "label": "Stat label",
      "default": "people saved our ruqyah posts this month."
    },
    {
      "type": "text",
      "id": "checkout_note",
      "label": "Checkout note",
      "default": "Secure checkout · Apple Pay and Google Pay · Delivered to your inbox in seconds"
    }
  ],
  "presets": [
    {
      "name": "FATD landing"
    }
  ]
}
{% endschema %}
