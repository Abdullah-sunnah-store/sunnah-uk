{% comment %}
  TSS 06 — Founder's letter
  Portrait, issue line, serif pull-quote, italic signature, a rule-topped
  "this month's pick" card and a link through to the Journal.
{% endcomment %}

{% render 'tss-base' %}

{%- liquid
  assign s = section.settings
  assign uid = section.id

  # The product setting yields an object on OS 2.0 and a handle on older
  # themes — normalise both to a product object.
  assign p = s.pick_product
  if p != blank and p.handle == blank
    assign p = all_products[s.pick_product]
  endif

  assign pick_image = s.pick_image
  assign pick_vendor = s.pick_vendor
  assign pick_title = s.pick_title
  assign pick_url = s.pick_link

  if p != blank and p.handle != blank
    # Only inherit the product photo when neither an explicit image nor a theme
    # asset has been set, so a chosen asset is never overridden.
    if pick_image == blank and s.pick_image_asset == blank
      assign pick_image = p.featured_image
    endif
    if pick_vendor == blank
      assign pick_vendor = p.vendor
    endif
    if pick_title == blank
      assign pick_title = p.title
    endif
    if pick_url == blank
      assign pick_url = p.url
    endif
  endif
-%}

<style>
  #tss-founder-{{ uid }} {
    background: var(--tss-ivory);
    padding-block: {{ s.padding_top | default: 112 }}px {{ s.padding_bottom | default: 112 }}px;
  }

  #tss-founder-{{ uid }} .tss-founder__portrait {
    padding-inline: var(--tss-gutter);
  }

  #tss-founder-{{ uid }} .tss-founder__portrait .tss-clip {
    margin-inline: auto;
  }

  #tss-founder-{{ uid }} .tss-founder__body {
    margin-top: 40px;
    padding-inline: var(--tss-gutter);
  }

  #tss-founder-{{ uid }} .tss-founder__quote {
    margin-top: 24px;
    max-width: 42ch;
    font-family: var(--tss-serif);
    font-size: {{ s.quote_size | default: 26 }}px;
    font-weight: 500;
    line-height: 1.35;
    text-wrap: pretty;
    color: var(--tss-ink);
  }

  #tss-founder-{{ uid }} .tss-founder__name {
    margin-top: 32px;
    font-family: var(--tss-serif);
    font-size: 30px;
    font-style: italic;
    line-height: 1;
    color: var(--tss-green-mid);
  }

  #tss-founder-{{ uid }} .tss-founder__role {
    margin-top: 8px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(28 28 26 / 0.45);
  }

  #tss-founder-{{ uid }} .tss-founder__pick {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid rgb(8 41 30 / 0.12);
  }

  #tss-founder-{{ uid }} .tss-founder__pick-media {
    width: 34%;
    flex-shrink: 0;
  }

  #tss-founder-{{ uid }} .tss-founder__pick-vendor {
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(28 28 26 / 0.5);
  }

  #tss-founder-{{ uid }} .tss-founder__pick-title {
    margin-top: 4px;
    font-family: var(--tss-serif);
    font-size: 20px;
    font-weight: 500;
    color: var(--tss-ink);
  }

  #tss-founder-{{ uid }} .tss-founder__pick-title a {
    color: inherit;
    text-decoration: none;
  }

  #tss-founder-{{ uid }} .tss-founder__pick-title a:hover {
    color: var(--tss-green-mid);
  }

  #tss-founder-{{ uid }} .tss-founder__pick-desc {
    margin-top: 8px;
    max-width: 26ch;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.6;
    color: rgb(28 28 26 / 0.7);
  }

  #tss-founder-{{ uid }} .tss-founder__journal {
    margin-top: 40px;
    font-size: 14px;
  }

  /* Stacked, the portrait renders at 100vw — a 3:4 crop 2,500px tall on a
     1900px monitor, with the letter pushed below the fold. Set it beside the
     letter from 64rem up: the section is the grid, so its two children need no
     wrapper. The ivory ground still reads full-bleed because body carries the
     same colour. */
  @media (min-width: 64rem) {
    #tss-founder-{{ uid }} {
      display: grid;
      grid-template-columns: minmax(0, 46fr) minmax(0, 54fr);
      align-items: center;
      gap: 64px;
      max-width: var(--tss-max);
      margin-inline: auto;
      padding-inline: var(--tss-gutter);
    }

    #tss-founder-{{ uid }} .tss-founder__portrait,
    #tss-founder-{{ uid }} .tss-founder__body {
      padding-inline: 0;
    }

    #tss-founder-{{ uid }} .tss-founder__body {
      margin-top: 0;
    }

    #tss-founder-{{ uid }} .tss-founder__quote {
      max-width: none;
    }

    #tss-founder-{{ uid }} .tss-founder__pick-desc {
      max-width: 34ch;
    }
  }
</style>

<section
  id="tss-founder-{{ uid }}"
  class="tss-section"
  aria-labelledby="tss-founder-heading-{{ uid }}"
>
  <div class="tss-founder__portrait">
    <div class="tss-clip">
      <div>
        {% render 'tss-image',
          image: s.image,
          asset: s.image_asset,
          width: 1200,
          asset_width: 1024,
          asset_height: 1024,
          widths: '480,720,960,1200',
          sizes: '(min-width: 64rem) 560px, 100vw',
          alt: s.name,
          placeholder: 'lifestyle-1'
        %}
      </div>
    </div>
  </div>

  <div class="tss-founder__body">
    {%- if s.issue != blank -%}
      <div class="tss-rise">
        <p id="tss-founder-heading-{{ uid }}" class="tss-eyebrow">{{ s.issue | escape }}</p>
      </div>
    {%- endif -%}

    {%- if s.quote != blank -%}
      <div class="tss-rise">
        <p class="tss-founder__quote">{{ s.quote | escape }}</p>
      </div>
    {%- endif -%}

    <div class="tss-rise">
      {%- if s.name != blank -%}
        <p class="tss-founder__name">{{ s.name | escape }}</p>
      {%- endif -%}
      {%- if s.role != blank -%}
        <p class="tss-founder__role">{{ s.role | escape }}</p>
      {%- endif -%}
    </div>

    {%- if pick_title != blank or pick_image != blank or s.pick_image_asset != blank -%}
      <div class="tss-rise">
        <div class="tss-founder__pick">
          <div class="tss-founder__pick-media tss-clip">
            <div>
              {% render 'tss-image',
                image: pick_image,
                asset: s.pick_image_asset,
                width: 500,
                widths: '160,240,360,500',
                sizes: '34vw',
                alt: pick_title
              %}
            </div>
          </div>

          <div>
            {%- if pick_vendor != blank -%}
              <p class="tss-founder__pick-vendor">{{ pick_vendor | escape }}</p>
            {%- endif -%}
            {%- if pick_title != blank -%}
              <h3 class="tss-founder__pick-title">
                {%- if pick_url != blank -%}
                  <a href="{{ pick_url }}">{{ pick_title | escape }}</a>
                {%- else -%}
                  {{ pick_title | escape }}
                {%- endif -%}
              </h3>
            {%- endif -%}
            {%- if s.pick_description != blank -%}
              <p class="tss-founder__pick-desc">{{ s.pick_description | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if s.journal_label != blank -%}
      <div class="tss-rise">
        <a href="{{ s.journal_link | default: '#journal' }}" class="tss-link-gold tss-founder__journal">
          {{- s.journal_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "TSS 06 · Founder",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Letter" },
    { "type": "image_picker", "id": "image", "label": "Portrait (3:4)" },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Fallback theme asset",
      "info": "Filename in assets/. Used when no image is picked above.",
      "default": "tss-founder.jpg"
    },
    { "type": "text", "id": "issue", "label": "Issue line", "default": "No. 04 · Muharram" },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Pull-quote",
      "default": "The first gift I ever wrapped for this house was an attar for my mother. I got the ribbon wrong three times. I have kept that same ribbon in my drawer since 2017 — it is why we still fold every parcel by hand."
    },
    {
      "type": "range",
      "id": "quote_size",
      "label": "Pull-quote size",
      "min": 18,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    { "type": "text", "id": "name", "label": "Name", "default": "Yusuf Rahman" },
    { "type": "text", "id": "role", "label": "Role", "default": "Founder, The Sunnah Store" },
    { "type": "header", "content": "This month's pick" },
    {
      "type": "product",
      "id": "pick_product",
      "label": "Product",
      "info": "Fills in anything left blank below."
    },
    { "type": "image_picker", "id": "pick_image", "label": "Image (3:4)" },
    {
      "type": "text",
      "id": "pick_image_asset",
      "label": "Fallback theme asset",
      "info": "Filename in assets/. Takes priority over the product photo.",
      "default": "tss-founder-attar.jpg"
    },
    { "type": "text", "id": "pick_vendor", "label": "Maker" },
    { "type": "text", "id": "pick_title", "label": "Title" },
    {
      "type": "textarea",
      "id": "pick_description",
      "label": "Description",
      "default": "The one I reach for when the gift has to say something I cannot."
    },
    { "type": "url", "id": "pick_link", "label": "Link" },
    { "type": "header", "content": "Journal link" },
    {
      "type": "text",
      "id": "journal_label",
      "label": "Label",
      "default": "Read my latest letter in The Journal →"
    },
    { "type": "url", "id": "journal_link", "label": "Link" },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [{ "name": "TSS 06 · Founder" }]
}
{% endschema %}
