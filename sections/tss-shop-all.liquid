{% comment %}
  TSS 08 — The whole house
  Full-bleed closing image with a centred serif heading and outline CTA over a
  softer version of the hero gradient.
{% endcomment %}

{% render 'tss-base' %}

{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}

<style>
  #tss-shop-all-{{ uid }} .tss-shopall__media {
    position: relative;
    width: 100%;
    height: {{ s.height | default: 86 }}svh;
    overflow: hidden;
    background: var(--tss-green-dark);
  }

  #tss-shop-all-{{ uid }} .tss-shopall__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #tss-shop-all-{{ uid }} .tss-shopall__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(5, 30, 22, 0.88) 0%,
      rgba(5, 30, 22, 0.4) 30%,
      rgba(5, 30, 22, 0.15) 60%
    );
  }

  #tss-shop-all-{{ uid }} .tss-shopall__content {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 0 var(--tss-gutter) 80px;
    text-align: center;
  }

  #tss-shop-all-{{ uid }} .tss-shopall__title {
    margin-inline: auto;
    max-width: 16ch;
    font-family: var(--tss-serif);
    font-size: {{ s.title_size | default: 34 }}px;
    font-weight: 400;
    line-height: 1.1;
    text-wrap: balance;
    color: var(--tss-ivory);
  }

  #tss-shop-all-{{ uid }} .tss-shopall__cta {
    margin-top: 32px;
  }
</style>

<section
  id="tss-shop-all-{{ uid }}"
  class="tss-section"
  aria-label="{{ s.aria_label | default: 'The whole house' | escape }}"
>
  <div class="tss-shopall__media">
    {% render 'tss-image',
      image: s.image,
      asset: s.image_asset,
      class: 'tss-shopall__img',
      asset_width: 1024,
      asset_height: 1024,
      width: 1600,
      widths: '480,720,960,1280,1600',
      sizes: '100vw',
      alt: s.title,
      placeholder: 'lifestyle-2'
    %}

    <div class="tss-shopall__scrim" aria-hidden="true"></div>

    <div class="tss-shopall__content">
      {%- if s.title != blank -%}
        <div class="tss-rise">
          <h2 class="tss-shopall__title">{{ s.title | escape }}</h2>
        </div>
      {%- endif -%}

      {%- if s.button_label != blank -%}
        <div class="tss-rise" data-tss-delay="0.1">
          <div class="tss-shopall__cta">
            <a href="{{ s.button_link | default: '#' }}" class="tss-btn tss-btn--outline-ivory">
              {{- s.button_label | escape -}}
            </a>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TSS 08 · Shop all",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (portrait)" },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Fallback theme asset",
      "info": "Filename in assets/. Used when no image is picked above.",
      "default": "tss-shop-all.jpg"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "svh",
      "default": 86
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Everything we've chosen, in one place."
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Heading size",
      "min": 22,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Enter the House" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "aria_label", "label": "Section label", "default": "The whole house" }
  ],
  "presets": [{ "name": "TSS 08 · Shop all" }]
}
{% endschema %}
