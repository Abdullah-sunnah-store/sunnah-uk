{% comment %}
  TSS 07 — From the Journal
  Same snap rail as the makers section, with larger serif titles and a
  "Read the Journal" outline button below the progress bar.

  Blocks left empty pull the latest articles from the chosen blog.
{% endcomment %}

{% render 'tss-base' %}

{%- liquid
  assign s = section.settings
  assign uid = section.id

  # The blog setting yields an object on OS 2.0 and a handle on older themes.
  assign use_blog = false
  if section.blocks.size == 0 and s.blog != blank
    assign blog_obj = s.blog
    if blog_obj.handle == blank
      assign blog_obj = blogs[s.blog]
    endif
    if blog_obj.handle != blank
      assign use_blog = true
    endif
  endif

  assign article_limit = s.article_limit | default: 4
-%}

<style>
  #tss-journal-{{ uid }} {
    background: var(--tss-ivory);
    padding-block: {{ s.padding_top | default: 80 }}px {{ s.padding_bottom | default: 80 }}px;
    scroll-margin-top: 96px;
  }

  #tss-journal-{{ uid }} .tss-journal__rail-wrap {
    margin-top: 48px;
  }

  #tss-journal-{{ uid }} .tss-journal__title {
    margin-top: 20px;
    max-width: 20ch;
    font-family: var(--tss-serif);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.25;
    text-wrap: balance;
    color: var(--tss-ink);
  }

  #tss-journal-{{ uid }} .tss-journal__link {
    margin-top: 12px;
  }

  #tss-journal-{{ uid }} .tss-journal__cta {
    margin-top: 56px;
    padding-inline: var(--tss-gutter);
    text-align: center;
  }
</style>

<section
  id="tss-journal-{{ uid }}"
  class="tss-section"
  aria-labelledby="tss-journal-heading-{{ uid }}"
>
  <a id="journal" class="tss-sr-only" aria-hidden="true" tabindex="-1"></a>

  <div id="tss-journal-heading-{{ uid }}">
    {% render 'tss-head', eyebrow: s.eyebrow, title: s.title, lede: s.lede %}
  </div>

  <div class="tss-journal__rail-wrap">
    <div
      class="tss-rail"
      role="region"
      tabindex="0"
      aria-label="{{ s.rail_label | default: 'Stories from the Journal' | escape }}"
      data-progress="tss-journal-progress-{{ uid }}"
    >
      {%- if use_blog -%}
        {%- for article in blog_obj.articles limit: article_limit -%}
          <article>
            <div class="tss-clip">
              <div>
                {% render 'tss-image',
                  image: article.image,
                  sizes: '(min-width: 64rem) 24vw, (min-width: 40rem) 46vw, 78vw',
                  alt: article.title,
                  placeholder: 'lifestyle-2'
                %}
              </div>
            </div>
            <div class="tss-rise">
              <h3 class="tss-journal__title">{{ article.title | escape }}</h3>
              <div class="tss-journal__link">
                <a href="{{ article.url }}" class="tss-link-gold">
                  {{- s.read_label | default: 'Read →' | escape -}}
                </a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- liquid
            assign a_title = b.title
            assign a_url = b.link
            assign a_image = b.image

            assign art = b.article
            if art != blank and art.handle == blank
              assign art = articles[b.article]
            endif

            if art != blank and art.handle != blank
              if a_title == blank
                assign a_title = art.title
              endif
              if a_url == blank
                assign a_url = art.url
              endif
              if a_image == blank
                assign a_image = art.image
              endif
            endif
          -%}
          <article {{ block.shopify_attributes }}>
            <div class="tss-clip">
              <div>
                {% render 'tss-image',
                  image: a_image,
                  asset: b.image_asset,
                  sizes: '(min-width: 64rem) 24vw, (min-width: 40rem) 46vw, 78vw',
                  alt: a_title,
                  placeholder: 'lifestyle-2'
                %}
              </div>
            </div>
            <div class="tss-rise">
              {%- if a_title != blank -%}
                <h3 class="tss-journal__title">{{ a_title | escape }}</h3>
              {%- endif -%}
              <div class="tss-journal__link">
                <a href="{{ a_url | default: '#' }}" class="tss-link-gold">
                  {{- s.read_label | default: 'Read →' | escape -}}
                </a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="tss-progress" id="tss-journal-progress-{{ uid }}" aria-hidden="true">
      <span></span>
    </div>
  </div>

  {%- if s.button_label != blank -%}
    <div class="tss-rise">
      <div class="tss-journal__cta">
        <a href="{{ s.button_link | default: '#' }}" class="tss-btn tss-btn--outline-green">
          {{- s.button_label | escape -}}
        </a>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "TSS 07 · Journal",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Reading Room" },
    { "type": "textarea", "id": "title", "label": "Headline", "default": "From the Journal" },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting text",
      "default": "Slower reading on giving, faith and the making of beautiful things."
    },
    { "type": "header", "content": "Articles" },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Used only when no Article blocks are added."
    },
    {
      "type": "range",
      "id": "article_limit",
      "label": "Articles to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    { "type": "text", "id": "read_label", "label": "Read link label", "default": "Read →" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read the Journal" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Layout" },
    { "type": "text", "id": "rail_label", "label": "Carousel label", "default": "Stories from the Journal" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Article",
      "settings": [
        { "type": "article", "id": "article", "label": "Article", "info": "Fills in anything left blank below." },
        { "type": "image_picker", "id": "image", "label": "Image (portrait)" },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Fallback theme asset",
          "info": "Filename in assets/. Used when no image is picked or inherited."
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TSS 07 · Journal",
      "blocks": [
        { "type": "article" },
        { "type": "article" },
        { "type": "article" },
        { "type": "article" }
      ]
    }
  ]
}
{% endschema %}
