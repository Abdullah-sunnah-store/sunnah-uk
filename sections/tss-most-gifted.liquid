{% comment %}
  TSS 04 — Most Gifted This Season
  An ordered edit: oversized ghosted serial, vendor, title and price beside a
  52%-wide portrait, alternating side each row.

  Picking a product fills in image, vendor, title, price and link.
{% endcomment %}

{% render 'tss-base' %}

{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}

<style>
  #tss-most-gifted-{{ uid }} {
    background: var(--tss-ivory);
    padding-block: {{ s.padding_top | default: 80 }}px {{ s.padding_bottom | default: 80 }}px;
    scroll-margin-top: 96px;
  }

  #tss-most-gifted-{{ uid }} .tss-mg__list {
    display: flex;
    flex-direction: column;
    gap: 64px;
    margin-top: 56px;
    padding-inline: var(--tss-gutter);
  }

  #tss-most-gifted-{{ uid }} .tss-mg__row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  #tss-most-gifted-{{ uid }} .tss-mg__row--flip {
    flex-direction: row-reverse;
  }

  #tss-most-gifted-{{ uid }} .tss-mg__media {
    position: relative;
    width: 52%;
    flex-shrink: 0;
  }

  #tss-most-gifted-{{ uid }} .tss-mg__body {
    position: relative;
    flex: 1;
    text-align: left;
  }

  #tss-most-gifted-{{ uid }} .tss-mg__row--flip .tss-mg__body {
    text-align: right;
  }

  #tss-most-gifted-{{ uid }} .tss-mg__serial {
    display: block;
    font-family: var(--tss-serif);
    font-size: 56px;
    line-height: 1;
    color: rgb(8 41 30 / 0.15);
  }

  #tss-most-gifted-{{ uid }} .tss-mg__vendor {
    margin-top: 12px;
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(28 28 26 / 0.5);
  }

  #tss-most-gifted-{{ uid }} .tss-mg__title {
    margin-top: 8px;
    font-family: var(--tss-serif);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.25;
    text-wrap: balance;
    color: var(--tss-ink);
  }

  #tss-most-gifted-{{ uid }} .tss-mg__title a {
    color: inherit;
    text-decoration: none;
  }

  #tss-most-gifted-{{ uid }} .tss-mg__title a:hover {
    color: var(--tss-green-mid);
  }

  #tss-most-gifted-{{ uid }} .tss-mg__price {
    margin-top: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--tss-gold);
  }

  #tss-most-gifted-{{ uid }} .tss-mg__cta {
    margin-top: 64px;
    padding-inline: var(--tss-gutter);
    text-align: center;
  }

  /* The rows are sized off the viewport, so uncapped they grew with the
     monitor — 52% of 1900px is a 975px portrait standing 1300px tall. Hold the
     edit to a reading measure and each row settles at a normal ~540px. */
  @media (min-width: 64rem) {
    #tss-most-gifted-{{ uid }} .tss-mg__list {
      max-width: 1040px;
      margin-top: 64px;
      margin-inline: auto;
      gap: 72px;
    }

    #tss-most-gifted-{{ uid }} .tss-mg__row {
      gap: 48px;
    }

    #tss-most-gifted-{{ uid }} .tss-mg__media {
      width: 42%;
    }

    #tss-most-gifted-{{ uid }} .tss-mg__serial {
      font-size: 72px;
    }

    #tss-most-gifted-{{ uid }} .tss-mg__title {
      font-size: 26px;
    }
  }
</style>

<section
  id="tss-most-gifted-{{ uid }}"
  class="tss-section"
  aria-labelledby="tss-mg-heading-{{ uid }}"
>
  <a id="most-gifted" class="tss-sr-only" aria-hidden="true" tabindex="-1"></a>

  <div id="tss-mg-heading-{{ uid }}">
    {% render 'tss-head', eyebrow: s.eyebrow, title: s.title, lede: s.lede %}
  </div>

  <ol class="tss-mg__list">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      {%- liquid
        # The product setting yields an object on OS 2.0 and a handle on older
        # themes — normalise both to a product object.
        assign p = b.product
        if p != blank and p.handle == blank
          assign p = all_products[b.product]
        endif

        assign i_image = b.image
        assign i_vendor = b.vendor
        assign i_title = b.title
        assign i_price = b.price
        assign i_url = b.link

        if p != blank and p.handle != blank
          # Inherit the product photo whenever the merchant has not picked an
          # image outright. The theme asset stays a fallback below it, as its
          # own help text promises ("used when no image is picked or
          # inherited") — gating on it too meant the seeded tss-gift-0N.jpg
          # defaults blocked every product photo from ever showing.
          if i_image == blank
            assign i_image = p.featured_image
          endif
          if i_vendor == blank
            assign i_vendor = p.vendor
          endif
          if i_title == blank
            assign i_title = p.title
          endif
          if i_price == blank
            assign i_price = p.price | money
          endif
          if i_url == blank
            assign i_url = p.url
          endif
        endif

        assign serial = forloop.index | prepend: '0' | slice: -2, 2
      -%}

      <li {{ block.shopify_attributes }}>
        <div class="tss-rise">
          <div class="tss-mg__row{% cycle 'sides': '', ' tss-mg__row--flip' %}">
            <div class="tss-mg__media tss-clip">
              <div>
                {% render 'tss-image',
                  image: i_image,
                  asset: b.image_asset,
                  width: 800,
                  widths: '280,420,560,800',
                  sizes: '(min-width: 64rem) 420px, 52vw',
                  alt: i_title,
                  placeholder: 'product-2'
                %}
              </div>
            </div>

            <div class="tss-mg__body">
              <span class="tss-mg__serial" aria-hidden="true">{{ serial }}</span>

              {%- if i_vendor != blank -%}
                <p class="tss-mg__vendor">{{ i_vendor | escape }}</p>
              {%- endif -%}

              {%- if i_title != blank -%}
                <h3 class="tss-mg__title">
                  <span class="tss-sr-only">No. {{ serial }},</span>
                  {%- if i_url != blank -%}
                    <a href="{{ i_url }}">{{ i_title | escape }}</a>
                  {%- else -%}
                    {{ i_title | escape }}
                  {%- endif -%}
                </h3>
              {%- endif -%}

              {%- if i_price != blank -%}
                <p class="tss-mg__price">{{ i_price }}</p>
              {%- endif -%}
            </div>
          </div>
        </div>
      </li>
    {%- endfor -%}
  </ol>

  {%- if s.button_label != blank -%}
    <div class="tss-rise">
      <div class="tss-mg__cta">
        <a href="{{ s.button_link | default: '#' }}" class="tss-link-green">{{ s.button_label | escape }}</a>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "TSS 04 · Most gifted",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved This Season" },
    {
      "type": "textarea",
      "id": "title",
      "label": "Headline",
      "info": "Each line reveals separately.",
      "default": "Most gifted\nthis season"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting text",
      "default": "An edit, not a shelf — the four our visitors reached for most this season, in the order they chose them."
    },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See all bestsellers →" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Gift",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Fills in anything left blank below." },
        { "type": "image_picker", "id": "image", "label": "Image (portrait)" },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Fallback theme asset",
          "info": "Filename in assets/. Used when no image is picked or inherited."
        },
        { "type": "text", "id": "vendor", "label": "Maker" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "price", "label": "Price" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TSS 04 · Most gifted",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
