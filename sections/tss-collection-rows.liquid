{% comment %}
  TSS — Collection rows
  Stacked full-bleed banners, one per collection, with the name set in serif at
  the bottom-left over an editorial photograph. Mirrors the occasion rows on
  thesunnahstoremarketplace.vercel.app/gifts/by-occasion

  Each row takes its link, label and image from a picked collection, and every
  one of those can be overridden per block.
{% endcomment %}

{% render 'tss-base' %}

{%- liquid
  assign s = section.settings
  assign uid = section.id

  comment
    Menu mode: the rows are the children of the menu item that links to the
    collection being viewed, so a parent category lists its subcategories.
  endcomment
  assign from_menu = false
  assign menu_parent = nil
  if s.source == 'menu'
    assign from_menu = true
    if collection != blank and s.menu != blank
      for l in linklists[s.menu].links
        assign lp = l.url | split: '?' | first
        if l.links.size > 0
          if lp == request.path or l.object.handle == collection.handle
            assign menu_parent = l
            break
          endif
        endif
      endfor
    endif
  endif

  if from_menu
    assign items = menu_parent.links
  else
    assign items = section.blocks
  endif

  assign foot_url = s.foot_url
  if foot_url == blank and menu_parent != nil
    assign foot_url = collection.url | append: '?view=grid'
  endif

  assign foot_text = s.foot_text
  if collection != blank
    assign foot_text = foot_text | replace: '[title]', collection.title
  endif
-%}

{%- unless from_menu and menu_parent == nil -%}

<style>
  #tss-crows-{{ uid }} {
    background: var(--tss-ivory);
    padding-block: {{ s.padding_top | default: 0 }}px {{ s.padding_bottom | default: 64 }}px;
  }

  #tss-crows-{{ uid }} .tss-crows__list {
    display: flex;
    flex-direction: column;
    /* The ivory beneath shows through as the hairline between banners. */
    gap: {{ s.gap | default: 4 }}px;
  }

  #tss-crows-{{ uid }} .tss-crows__row {
    position: relative;
    display: block;
    height: {{ s.row_height | default: 200 }}px;
    overflow: hidden;
    background: var(--tss-green-dark);
    text-decoration: none;
  }

  #tss-crows-{{ uid }} .tss-crows__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--tss-ease);
  }

  #tss-crows-{{ uid }} a.tss-crows__row:hover .tss-crows__img {
    transform: scale(1.04);
  }

  #tss-crows-{{ uid }} .tss-crows__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(5, 30, 22, {{ s.scrim | default: 55 | divided_by: 100.0 }}) 0%,
      rgba(5, 30, 22, {{ s.scrim | default: 55 | times: 0.27 | divided_by: 100.0 }}) 45%,
      rgba(5, 30, 22, 0) 75%
    );
  }

  #tss-crows-{{ uid }} .tss-crows__body {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: var(--tss-gutter);
  }

  #tss-crows-{{ uid }} .tss-crows__label {
    font-family: var(--tss-serif);
    font-size: {{ s.label_size | default: 26 }}px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    color: var(--tss-ivory);
  }

  #tss-crows-{{ uid }} .tss-crows__count {
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgb(245 240 232 / 0.6);
  }

  #tss-crows-{{ uid }} .tss-crows__arrow {
    margin-inline-start: auto;
    align-self: center;
    color: var(--tss-gold-bright);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.4s ease, transform 0.4s var(--tss-ease);
  }

  #tss-crows-{{ uid }} a.tss-crows__row:hover .tss-crows__arrow,
  #tss-crows-{{ uid }} a.tss-crows__row:focus-visible .tss-crows__arrow {
    opacity: 1;
    transform: none;
  }

  #tss-crows-{{ uid }} a.tss-crows__row:focus-visible {
    outline: 2px solid var(--tss-gold-bright);
    outline-offset: -4px;
  }

  #tss-crows-{{ uid }} .tss-crows__foot {
    padding: 64px var(--tss-gutter);
    text-align: center;
  }

  #tss-crows-{{ uid }} .tss-crows__foot-link {
    font-family: var(--tss-serif);
    font-size: 18px;
    font-style: italic;
    color: var(--tss-ink);
    text-decoration: none;
    transition: color 0.4s ease;
  }

  #tss-crows-{{ uid }} .tss-crows__foot-link:hover {
    color: var(--tss-green-mid);
  }

  #tss-crows-{{ uid }} .tss-crows__empty {
    padding: 48px var(--tss-gutter);
    font-size: 14px;
    color: rgb(28 28 26 / 0.55);
  }

  @media (prefers-reduced-motion: reduce) {
    #tss-crows-{{ uid }} .tss-crows__img,
    #tss-crows-{{ uid }} .tss-crows__arrow {
      transition: none;
    }
  }
</style>

<section
  id="tss-crows-{{ uid }}"
  class="tss-section"
  {% if s.aria_label != blank %}aria-label="{{ s.aria_label | escape }}"{% endif %}
  {{ section.shopify_attributes }}
>
  {%- if items.size > 0 -%}
    <div class="tss-crows__list">
      {%- for item in items -%}
        {%- liquid
          if from_menu
            assign col = nil
            if item.type == 'collection_link'
              assign col = item.object
            endif
            assign label = item.title
            assign url = item.url
            assign row_image = col.featured_image
            assign row_asset = ''
            assign row_attrs = ''
          else
            assign b = item.settings
            assign col = b.collection

            assign label = b.label
            if label == blank
              assign label = col.title
            endif

            assign url = b.link
            if url == blank and col != blank
              assign url = col.url
            endif

            assign row_image = b.image
            if row_image == blank
              assign row_image = col.featured_image
            endif
            assign row_asset = b.image_asset
            assign row_attrs = item.shopify_attributes
          endif

          assign tag = 'div'
          if url != blank
            assign tag = 'a'
          endif
        -%}

        <{{ tag }}
          class="tss-crows__row tss-rise"
          {% if url != blank %}href="{{ url }}"{% endif %}
          {{ row_attrs }}
        >
          {% render 'tss-image',
            image: row_image,
            asset: row_asset,
            class: 'tss-crows__img',
            asset_width: 1600,
            asset_height: 600,
            width: 1800,
            widths: '640,960,1280,1600,1800',
            sizes: '100vw',
            alt: label,
            placeholder: 'lifestyle-1'
          %}

          <span class="tss-crows__scrim" aria-hidden="true"></span>

          <span class="tss-crows__body">
            <span class="tss-crows__label">{{ label | escape }}</span>

            {%- if s.show_count and col != blank and col.products_count > 0 -%}
              <span class="tss-crows__count">{{ col.products_count }} {{ s.count_label | default: 'gifts' | escape }}</span>
            {%- endif -%}

            {%- if url != blank -%}
              <span class="tss-crows__arrow" aria-hidden="true">
                {% render 'tss-icon', icon: 'arrow-right', size: 20, stroke: 1.25 %}
              </span>
            {%- endif -%}
          </span>
        </{{ tag }}>
      {%- endfor -%}
    </div>

    {%- if foot_text != blank and foot_url != blank -%}
      <div class="tss-crows__foot tss-rise">
        <a class="tss-crows__foot-link" href="{{ foot_url }}">{{ foot_text | escape }}</a>
      </div>
    {%- endif -%}
  {%- else -%}
    <p class="tss-crows__empty">{{ s.empty_text | default: 'Add a row to start this list.' | escape }}</p>
  {%- endif -%}
</section>
{%- endunless -%}

{% schema %}
{
  "name": "TSS · Collection rows",
  "tag": "section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "Gifts by occasion" },
    {
      "type": "select",
      "id": "source",
      "label": "Rows come from",
      "options": [
        { "value": "blocks", "label": "Blocks below" },
        { "value": "menu", "label": "Submenu of this collection" }
      ],
      "default": "blocks",
      "info": "Submenu mode shows only on collections that head a menu item with children, and lists those children."
    },
    { "type": "link_list", "id": "menu", "label": "Menu" },
    { "type": "header", "content": "Rows" },
    {
      "type": "range",
      "id": "row_height",
      "label": "Row height",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    { "type": "range", "id": "gap", "label": "Gap between rows", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 4 },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 18,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "scrim",
      "label": "Image darkening",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    { "type": "checkbox", "id": "show_count", "label": "Show the product count", "default": false },
    { "type": "text", "id": "count_label", "label": "Count word", "default": "gifts" },
    { "type": "header", "content": "Closing link" },
    { "type": "text", "id": "foot_text", "label": "Link text", "default": "Not sure yet? See everything we've chosen →" },
    {
      "type": "url",
      "id": "foot_url",
      "label": "Link",
      "info": "In submenu mode, leave empty to open this collection's full product grid. Use [title] in the text for the collection name."
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "text", "id": "empty_text", "label": "Empty text", "default": "Add a row to start this list." }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Supplies the label, link and image unless they are set below."
        },
        { "type": "text", "id": "label", "label": "Label", "info": "Overrides the collection title." },
        { "type": "url", "id": "link", "label": "Link", "info": "Overrides the collection link." },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overrides the collection image. Landscape crops read best."
        },
        { "type": "text", "id": "image_asset", "label": "Theme asset", "info": "Filename in assets/, used when nothing else resolves." }
      ]
    }
  ],
  "presets": [
    {
      "name": "TSS · Collection rows",
      "blocks": [
        { "type": "row", "settings": { "label": "Eid ul-Fitr" } },
        { "type": "row", "settings": { "label": "Eid ul-Adha" } },
        { "type": "row", "settings": { "label": "Ramadan" } },
        { "type": "row", "settings": { "label": "Nikah" } }
      ]
    }
  ]
}
{% endschema %}
