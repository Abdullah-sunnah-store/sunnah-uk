{% comment %}
  TSS Base — loads the shared design tokens, fonts and scroll-reveal engine.

  Render at the top of every TSS section:
    {% render 'tss-base' %}

  Duplicate <link>/<script> tags across sections resolve to the same cached
  asset URLs, and tss-base.js self-guards, so repeat renders are harmless.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap"
>
{{ 'tss-base.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tss-base.js' | asset_url }}" defer></script>
